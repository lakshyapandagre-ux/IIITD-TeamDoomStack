PROJECT_NAME="MyCampus API"
DATABASE_URL="sqlite:///./mycampus.db"
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000"
HOST="127.0.0.1"
PORT=8000

# AI Provider Configuration (Choose one or both; leave empty for manual/unconfigured mode)
# Google Gemini (Supports Text + Vision Multimodal extraction)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# OpenAI (Alternative provider: Supports Text + GPT-4o Vision extraction)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Demo Session Signing Secret (Used for judge demo authentication tokens)
DEMO_JWT_SECRET="mycampus_demo_secret_2026_collegiate_judges_evaluation"
